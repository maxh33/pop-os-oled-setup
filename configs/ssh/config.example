# SSH Configuration Template
# Copy to ~/.ssh/config and customize

# Use 1Password SSH agent (optional)
Host *
    IdentityAgent ~/.1password/agent.sock

# Example server
# IdentitiesOnly yes is not optional here if you use an agent (1Password,
# ssh-agent) with multiple keys loaded: without it, the agent offers every
# key it holds, and a server with a low MaxAuthTries disconnects with
# "Too many authentication failures" before it ever tries the right one —
# looks like a broken key even when the key itself is fine.
# See docs/22-netcup-ssh-lockout-recovery.md.
Host myserver
    HostName your.server.ip
    User your_username
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Cloud VM (e.g. Oracle Cloud Free Tier ARM instance) — default user is
# "ubuntu" on Ubuntu images, not root. Same IdentitiesOnly requirement as
# above applies.
Host mycloudvm
    HostName your.instance.ip
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Multi-machine access to the same server: generate a separate keypair per
# machine (home, work laptop, etc.), give each its own Host alias pointing
# at its own IdentityFile, and append every machine's *.pub to the
# server's ~/.ssh/authorized_keys. Never copy a private key between
# machines — one keypair per machine keeps revocation per-device.

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
