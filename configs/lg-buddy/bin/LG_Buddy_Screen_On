#!/bin/bash

tv_ip="192.168.X.X"
tv_mac="XX:XX:XX:XX:XX:XX"
input="HDMI_4"
STATE_DIR="/run/user/$(id -u)/lg_buddy"
STATE_FILE="${STATE_DIR}/screen_off_by_us"

# Only wake the TV if we were the ones who turned it off
if [ ! -f "$STATE_FILE" ]; then
    echo "State file not found. TV was not turned off by LG Buddy. Skipping wake."
    exit 0
fi

echo "Turning TV on (screen wake)..."

# Remove state file first (before potentially slow operations)
rm -f "$STATE_FILE"

# Send Wake-on-LAN to wake the TV from standby
wakeonlan "$tv_mac"

# Wait for TV to accept WebSocket connections (retry loop for warm boot/EWS startup)
sleep 4
success=false
for i in {1..6}; do
    if /usr/bin/LG_Buddy_PIP/bin/bscpylgtvcommand "$tv_ip" set_input "$input" 2>/dev/null; then
        echo "TV switched to $input successfully (attempt $i)."
        success=true
        break
    fi
    sleep 2
done

if [ "$success" = false ]; then
    echo "set_input failed after multiple attempts (TV may need more time to wake)"
fi
