#!/bin/bash
# Detecta o timeout de inatividade das configuracoes de tela do COSMIC; fallback 600s.
COSMIC_IDLE_FILE="$HOME/.config/cosmic/com.system76.CosmicIdle/v1/screen_off_time"
if [ -f "$COSMIC_IDLE_FILE" ]; then
    ms=$(grep -oP '\d+' "$COSMIC_IDLE_FILE" 2>/dev/null)
    if [ -n "$ms" ] && [ "$ms" -gt 0 ]; then
        IDLE_TIMEOUT=$(( ms / 1000 ))
    fi
fi
IDLE_TIMEOUT="${IDLE_TIMEOUT:-600}"
LOCK="/run/user/$(id -u)/lg_buddy/lock"; mkdir -p "$(dirname "$LOCK")"
echo "Starting LG Buddy Screen Monitor using swayidle (timeout: ${IDLE_TIMEOUT}s). Acordar a TV: so Shift/Ctrl (lg-buddy-key-wake)."
# so DESLIGA por inatividade (sem 'resume': mouse nao acende a TV); flock evita correr junto com o 'ligar'
exec swayidle -w timeout "$IDLE_TIMEOUT" "flock -w 60 $LOCK $HOME/.local/bin/LG_Buddy_Screen_Off"
